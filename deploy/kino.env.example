MEDIA_DIR=/srv/torbox
DATA_DIR=/var/lib/kino
SYNC_STATUS=/var/lib/torbox-sync/status.json
PAUSE_FILE=/var/lib/kino/pause.json
DELETED_FILE=/var/lib/kino/deleted.json
SYNC_UNIT=torbox-sync.service
TIMER_UNIT=torbox-sync.timer
COOKIE_SECURE=1
MAX_FFMPEG=20
# How many devices one profile can watch converted streams on at the same time
PROFILE_DEVICES=3
RESCAN_MINUTES=10
KINO_SECRET=REPLACED_BY_INSTALLER
