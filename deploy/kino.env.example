MEDIA_DIR=/srv/torbox
DATA_DIR=/var/lib/kino
SYNC_STATUS=/var/lib/torbox-sync/status.json
PAUSE_FILE=/var/lib/kino/pause.json
DELETED_FILE=/var/lib/kino/deleted.json
SYNC_UNIT=torbox-sync.service
TIMER_UNIT=torbox-sync.timer
COOKIE_SECURE=1
MAX_FFMPEG=20
# How many devices one profile can watch converted streams on at the same time
PROFILE_DEVICES=3
RESCAN_MINUTES=10
KINO_SECRET=REPLACED_BY_INSTALLER

# Limits on what the server asks of other hosts (addons and the sources they point to). Both are optional.
# How many requests to one host run at once, a host that answers "too many requests" is left alone for as long as it asks
UPSTREAM_PER_HOST=3
# More than one address on this machine to leave from, comma separated (add them at the VPS provider and on the server first). A source
# always uses the same one, so links that are tied to an address keep working. Empty means the machine's normal address.
#OUTBOUND_IPS=203.0.113.10,203.0.113.11
