[Unit]
Description=Kino dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=kino
Group=kino
# The torbox key comes from the sync's own env file so its only kept in one place, kino.env still wins for everything else
EnvironmentFile=-/root/torbox-sync/.env
EnvironmentFile=/etc/kino/kino.env
WorkingDirectory=/opt/kino
ExecStart=/opt/kino/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8282 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3
StateDirectory=kino
StateDirectoryMode=0755
# Locks the app down so even if something goes wrong it cant touch the rest of the vps
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
# A few more locks. Nothing here is used by the app or ffmpeg (no hardware accel, no websockets), the sshfs mount is
# made by systemd and not by this service so it still works
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# Limits. MemoryHigh is only a soft limit, past it the app gets slowed down and not killed, change it to fit the vps.
# The ffmpeg streams count towards it too so dont set it to low. There is no MemoryMax on purpose, a hard kill in the
# middle of a big guide parse would be worse
MemoryHigh=3G
TasksMax=4096
LimitNOFILE=65536
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
