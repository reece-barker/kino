[Unit]
Description=TorBox to storage box sync
After=network-online.target
Wants=network-online.target
# Wont start unless the storage box is actualy mounted, so it cant write to the local disk by mistake
RequiresMountsFor=/srv/torbox

[Service]
Type=oneshot
EnvironmentFile=/root/torbox-sync/.env
Environment=SYNC_STATUS=/var/lib/torbox-sync/status.json
Environment=PAUSE_FILE=/var/lib/kino/pause.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kino/venv/bin/python /root/torbox-sync/sync.py
# Makes /var/lib/torbox-sync for the status file the dashboard reads
StateDirectory=torbox-sync
StateDirectoryMode=0755
# First run can take days so no timeout
TimeoutStartSec=infinity
KillSignal=SIGTERM
TimeoutStopSec=20
# Runs as root so it gets a few locks, and it stays out of the way of the dashboard while a big sync is going.
# No ProtectHome on purpose, sync.py its self lives in /root/torbox-sync and it wouldnt even start
Nice=10
IOSchedulingClass=idle
CPUWeight=50
PrivateTmp=yes
NoNewPrivileges=yes
